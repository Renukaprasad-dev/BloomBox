# ==============================================================================
# BloomBox Environment Configuration Example
# Copy this file to .env.local and populate with your environment credentials.
# NEVER commit .env.local or sensitive credentials to version control.
# ==============================================================================

# Neon Serverless PostgreSQL Database Connection String
# Format: postgresql://[user]:[password]@[endpoint-hostname]/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@ep-sample-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Admin Console Authentication Passcode (Default fallback: bloombox@2026)
ADMIN_PASSCODE="your_secure_admin_passcode_here"

# Statutory Seller GSTIN (Format: 2 digits state code + 10 char PAN + 1 entity + 1 Z + 1 check digit)
NEXT_PUBLIC_STUDIO_GSTIN="27AABCB1234F1Z9"
